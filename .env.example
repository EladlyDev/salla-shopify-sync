# ── Server ───────────────────────────────────────────────
PORT=3000

# ── Shopify ──────────────────────────────────────────────
SHOPIFY_SHOP=                    # e.g., store.myshopify.com
SHOPIFY_ACCESS_TOKEN=            # Admin API access token
SHOPIFY_WEBHOOK_SECRET=          # Webhook signing secret
SHOPIFY_LOCATION_ID=             # Primary location ID (number)
SHOPIFY_API_VERSION=2024-10

# ── Salla ────────────────────────────────────────────────
SALLA_BASE_URL=https://api.salla.dev/admin/v2
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_ACCESS_TOKEN=
SALLA_REFRESH_TOKEN=
SALLA_WEBHOOK_SECRET=

# ── Redis (required for BullMQ job queues) ───────────────
REDIS_URL=redis://localhost:6379

# ── Telegram Alerts ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Dashboard ───────────────────────────────────────────
DASHBOARD_PASSWORD=admin123
